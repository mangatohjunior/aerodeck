# Copy to .env for local development. Never commit .env.
AERODECK_ENV=local
AERODECK_LOG_LEVEL=DEBUG

# Async PostgreSQL URL. Apply schema with: alembic upgrade head
AERODECK_DATABASE_URL=postgresql+asyncpg://aerodeck:aerodeck@localhost:5432/aerodeck

# Celery broker and result backend. Start a worker with:
#   celery -A app.worker worker --beat --queues aerodeck --loglevel INFO
AERODECK_REDIS_URL=redis://localhost:6379/0
# Seconds the deployment log SSE waits for the next line (or Done) after catching up.
# AERODECK_DEPLOYMENT_LOG_FOLLOW_IDLE_SECONDS=1800

# At least 32 characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AERODECK_AUTH_SIGNING_KEY=replace-with-at-least-32-random-characters

# client_id -> SHA-256 hex digest of the client secret. See app/core/config.py.
# The digest below is for the secret "local-dev-secret"; do not reuse outside local.
AERODECK_AUTH_CLIENTS={"local-cli": "eb26d4a9a0ef04727f52fb5acc8936196ae90e23003fc5117ce8e3e28c49363f"}

# Optional static bearer Traefik sends to GET /api/v1/edge/traefik.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# AERODECK_TRAEFIK_PROVIDER_TOKEN=

# DNS-01: memory (fake ACME, default) or digitalocean (needs the token below).
# AERODECK_DNS01_PROVIDER=memory
# AERODECK_DIGITALOCEAN_TOKEN=
# AERODECK_ACME_ISSUER=fake
# AERODECK_ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
# AERODECK_ACME_ACCOUNT_EMAIL=
# AERODECK_ACME_ACCOUNT_KEY=
# Private keys for issued certs. Not a database column. Bind-mount this directory.
# AERODECK_CERTIFICATE_KEY_DIR=/var/lib/aerodeck/certs

# Public address records created and deleted with each route.
# AERODECK_DNS_RECORDS_PROVIDER=memory
# AERODECK_DNS_RECORD_TYPE=CNAME
# AERODECK_DNS_RECORD_TARGET=edge.aero-deck.app
# AERODECK_DNS_RECORD_TTL=300

# Firecracker sandboxes. memory (default) needs no KVM; firecracker talks to the API URL.
# AERODECK_SANDBOX_HYPERVISOR=memory
# AERODECK_SANDBOX_IMAGE_ROOT=/var/lib/aerodeck/images
# AERODECK_FIRECRACKER_API_URL=http://127.0.0.1:8080
# AERODECK_SANDBOX_REAP_INTERVAL_SECONDS=60

# Tenant IaC from the worker (#34). Off = NoopProvisioner. Plan-only unless APPLY is true.
# Never set IAC_WORKER on a laptop. Prod applies a stored plan file; no -auto-approve.
# AERODECK_IAC_WORKER=true
# AERODECK_IAC_APPLY=false
# AERODECK_IAC_ENGINE_ROOT=/opt/aerodeck/iac-engine/stacks/tenant
# AERODECK_SPACES_ACCESS_ID=
# AERODECK_SPACES_SECRET_KEY=
